<!doctype html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        {% include "partials/counters.njk" %}
        <title>{{ seoTitle or title or site.name }}</title>
        <link rel="canonical" href="{{ (canonical or page.url) | absoluteUrl }}" />
        {% include "partials/head-assets.njk" %}
        <meta property="og:title" content="{{ ogTitle or seoTitle or title or site.name }}" />
        <meta property="og:description" content="{{ ogDescription or seoDescription or description or site.description }}" />
        <meta property="og:image" content="{{ (image or site.ogImage) | absoluteUrl }}" />
        <meta property="og:url" content="{{ (canonical or page.url) | absoluteUrl }}" />
        <meta property="og:type" content="{{ ogType or 'website' }}" />
        <meta property="og:locale" content="{{ site.locale }}" />
        <meta property="og:site_name" content="{{ site.shortName }}" />
        {% if ogType == "article" -%}
        <meta property="article:published_time" content="{{ date | isoDate }}" />
        <meta property="article:modified_time" content="{{ (updated or date) | isoDate }}" />
        <meta property="article:author" content="{{ author or site.author }}" />
        {% if category %}<meta property="article:section" content="{{ category | categoryName }}" />{% endif %}
        {%- endif %}
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="description"
            content="{{ seoDescription or description or site.description }}"
        />
        {% if noindex %}<meta name="robots" content="noindex, follow" />{% endif %}
        <style>
{% include "css/main.css" %}
{% if includeBlogCss %}{% include "css/blog.css" %}{% endif %}
        </style>
        {% if jsonld %}<script type="application/ld+json">{{ jsonld | jsonld | safe }}</script>{% endif %}
        {% for ld in extraJsonld %}<script type="application/ld+json">{{ ld | jsonld | safe }}</script>
        {% endfor %}
    </head>
    <body>
        {% include "partials/header.njk" %}
{{ content | safe }}
        {% include "partials/footer.njk" %}
        {% include "partials/modal.njk" %}
        {% include "partials/scripts.njk" %}
    </body>
</html>
