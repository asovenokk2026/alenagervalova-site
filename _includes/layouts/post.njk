---
layout: layouts/base.njk
---
{%- set cat = categories | selectattr("slug", "equalto", category) | first -%}
{%- set midCta -%}
<aside class="post-inline-cta">
    <p class="post-inline-cta-text">
        <strong>Узнали себя?</strong> На консультации разберём именно вашу
        ситуацию — что за этим стоит и что с этим делать.
    </p>
    <a href="#" class="post-inline-cta-link" onclick="openModal(); return false;">
        Записаться на консультацию →
    </a>
</aside>
{%- endset -%}
<main class="blog-bg">
    <article class="post">
        <header class="post-head">
            <nav aria-label="Хлебные крошки">
                <ol class="crumbs">
                    <li><a href="/">Главная</a></li>
                    <li><a href="/blog/">Блог</a></li>
                    {% if cat %}<li><a href="/blog/kategoriya/{{ cat.slug }}/">{{ cat.name }}</a></li>{% endif %}
                    <li><span aria-current="page">{{ title | truncate(60) }}</span></li>
                </ol>
            </nav>
            <h1 class="post-title">{{ title }}</h1>
            {% if description %}<p class="post-lead">{{ description }}</p>{% endif %}
            <div class="post-meta">
                <span class="author">
                    <span class="avatar" aria-hidden="true">{{ (author or site.author) | first }}</span>
                    <span>{{ author or site.author }}</span>
                </span>
                {% if cat %}<a class="cat" href="/blog/kategoriya/{{ cat.slug }}/">{{ cat.name }}</a>{% endif %}
                <time datetime="{{ date | isoDate }}">{{ date | ruDate }}</time>
                {% if updated %}<time datetime="{{ updated | isoDate }}">Обновлено {{ updated | ruDate }}</time>{% endif %}
                <span>{{ content | readingTime }} мин чтения</span>
            </div>
        </header>

        {% if image %}
        <img
            src="{{ image }}"
            alt="{{ imageAlt or title }}"
            class="post-cover"
            width="1200"
            height="675"
            fetchpriority="high"
        />
        {% endif %}

        <div class="post-body">
{{ content | injectCta(midCta) | safe }}
        </div>

        {% if updated %}<p class="post-updated">Последнее обновление: {{ updated | ruDate }}</p>{% endif %}

        <aside class="post-cta" id="zapis">
            <h2>Хотите разобрать свою ситуацию?</h2>
            <p>
                Онлайн-консультация 50 минут в удобное время. Напишите мне
                в любой мессенджер — расскажете, что беспокоит, и я отвечу,
                смогу ли помочь. Первое сообщение ни к чему не обязывает.
            </p>
            <div class="post-cta-facts">
                <span class="post-cta-fact">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15 14" /></svg>
                    50 минут
                </span>
                <span class="post-cta-fact">
                    <svg viewBox="0 0 24 24"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                    от 2 500 ₽
                </span>
                <span class="post-cta-fact">
                    <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="14" rx="2" /><path d="M8 22h8M12 18v4" /></svg>
                    Онлайн, из любого города
                </span>
            </div>
            <div class="post-cta-actions">
                <a href="#" class="btn-primary" onclick="openModal(); return false;">
                    <svg viewBox="0 0 24 24">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    Записаться на консультацию
                </a>
                <a href="{{ site.contacts.whatsapp }}" target="_blank" rel="noopener" class="btn-ghost">WhatsApp</a>
                <a href="{{ site.contacts.telegram }}" target="_blank" rel="noopener" class="btn-ghost">Telegram</a>
            </div>
            {% if ctaReview %}
            <figure class="post-cta-review">
                <blockquote>{{ ctaReview }}</blockquote>
                {% if ctaReviewAuthor %}<figcaption>{{ ctaReviewAuthor }}</figcaption>{% endif %}
            </figure>
            {% endif %}
        </aside>

        {% if faq and faq.length %}
        <section class="post-faq" aria-labelledby="faq-title">
            <h2 id="faq-title">Частые вопросы</h2>
            {% for item in faq %}
            {% if item.question and item.answer %}
            <details class="faq-item"{% if loop.first %} open{% endif %}>
                <summary>{{ item.question }}</summary>
                <div class="faq-answer">{{ item.answer | markdown | safe }}</div>
            </details>
            {% endif %}
            {% endfor %}
        </section>
        {% endif %}

        <section class="post-author" aria-labelledby="author-title">
            <img
                src="/images/hero.webp"
                alt="{{ site.author }} — психолог"
                class="post-author-photo"
                width="160"
                height="160"
                loading="lazy"
            />
            <div class="post-author-text">
                <span class="post-author-label">Автор статьи</span>
                <h2 id="author-title">{{ site.author }}</h2>
                <p>
                    Практикующий психолог, дипломы Московского института
                    психоанализа и Московского института психологии. Работаю
                    в методах когнитивно-поведенческой и эмоционально-образной
                    терапии. Более 500 клиентов, консультации онлайн.
                </p>
                <div class="post-author-actions">
                    <a href="#" class="btn-primary" onclick="openModal(); return false;">
                        Записаться на консультацию
                    </a>
                    <a href="/#about" class="post-author-more">Подробнее обо мне →</a>
                </div>
            </div>
        </section>

        <a href="/blog/" class="post-back">← Все статьи блога</a>
    </article>
</main>

{%- set relatedPosts = collections.posts | related(page.url, category, 3) -%}
{% if relatedPosts.length %}
<section class="post-related" aria-labelledby="related-title">
    <div class="post-related-inner">
        <div class="section-header fade-up">
            <span class="tag" style="font-size: 16px">Читайте также</span>
            <h2 class="section-title" id="related-title">Другие статьи блога</h2>
        </div>
        <div class="articles-grid">
            {% for post in relatedPosts %}
            {% set delay = loop.index %}
            {% set showMeta = true %}
            {% include "partials/post-card.njk" %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<div class="sticky-cta" id="stickyCta" hidden>
    <div class="sticky-messengers" id="stickyMessengers" hidden>
        <span class="sticky-messengers-title">Напишите в удобный мессенджер</span>
        <div class="sticky-messengers-grid">
            <a href="{{ site.contacts.whatsapp }}" target="_blank" rel="noopener" class="sticky-msg sticky-msg-wa">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                WhatsApp
            </a>
            <a href="{{ site.contacts.telegram }}" target="_blank" rel="noopener" class="sticky-msg sticky-msg-tg">
                <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                Telegram
            </a>
            <a href="{{ site.contacts.max }}" target="_blank" rel="noopener" class="sticky-msg sticky-msg-max">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                Max
            </a>
            <a href="{{ site.contacts.tgChannel }}" target="_blank" rel="noopener" class="sticky-msg sticky-msg-ch">
                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                Telegram-канал
            </a>
        </div>
    </div>
    <div class="sticky-cta-bar">
        <div class="sticky-cta-text">
            <strong>Онлайн-консультация</strong>
            <span>50 минут · от 2 500 ₽</span>
        </div>
        <button type="button" class="sticky-cta-btn" id="stickyToggle" aria-expanded="false">
            <span class="sticky-cta-btn-label">Записаться</span>
            <svg class="sticky-cta-chevron" viewBox="0 0 24 24"><polyline points="6 15 12 9 18 15" /></svg>
        </button>
    </div>
</div>

<script>
(function () {
    var bar = document.getElementById("stickyCta");
    if (!bar) return;
    var finalCta = document.getElementById("zapis");
    var panel = document.getElementById("stickyMessengers");
    var toggle = document.getElementById("stickyToggle");
    var shown = false;
    var open = false;

    function setOpen(v) {
        open = v;
        panel.hidden = !v;
        toggle.setAttribute("aria-expanded", v ? "true" : "false");
        bar.classList.toggle("is-open", v);
        toggle.querySelector(".sticky-cta-btn-label").textContent = v ? "Свернуть" : "Записаться";
    }

    toggle.addEventListener("click", function (e) {
        e.stopPropagation();
        setOpen(!open);
    });

    document.addEventListener("click", function (e) {
        if (open && !bar.contains(e.target)) setOpen(false);
    });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && open) setOpen(false);
    });

    function update() {
        var scrolled = window.scrollY > 400;
        var atFinal = false;
        if (finalCta) {
            var r = finalCta.getBoundingClientRect();
            atFinal = r.top < window.innerHeight && r.bottom > 0;
        }
        var need = scrolled && !atFinal;
        if (need !== shown) {
            shown = need;
            bar.hidden = !need;
            if (!need && open) setOpen(false);
        }
    }

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
})();
</script>
