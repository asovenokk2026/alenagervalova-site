{#- ожидает: post, delay (опц.), showMeta (опц.) -#}
<article class="article-card fade-up{% if delay %} d{{ delay }}{% endif %}">
    <div class="article-img-wrap">
        <img
            src="{{ post.data.image or '/images/blog/placeholder.png' }}"
            alt="{{ post.data.imageAlt or post.data.title }}"
            class="article-img"
            loading="lazy"
            width="600"
            height="338"
        />
    </div>
    <div class="article-body">
        {% if showMeta %}
        <div class="article-meta">
            <span class="cat">{{ post.data.category | categoryName }}</span>
            <time datetime="{{ post.date | isoDate }}">{{ post.date | ruDate }}</time>
        </div>
        {% endif %}
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.description }}</p>
        <span class="article-link">Читать статью →</span>
    </div>
</article>
