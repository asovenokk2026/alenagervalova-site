            <div class="section">
                <div class="section-header fade-up">
                    <span class="tag" style="font-size: 16px">Статьи</span>
                    <h2 class="section-title">Мой блог</h2>
                    <p class="section-sub">
                        Авторские статьи о психологии, отношениях и внутренних
                        переменах
                    </p>
                </div>
                {%- set latest = collections.posts | limit(3) %}
                {%- if latest.length %}
                <div class="articles-grid">
                    {%- for post in latest %}
                    {%- set delay = loop.index %}
                    {%- set showMeta = false %}
                    {% include "partials/post-card.njk" %}
                    {%- endfor %}
                </div>
                {%- endif %}
                <div
                    style="
                        display: flex;
                        justify-content: center;
                        margin-top: 32px;
                    "
                    class="fade-up"
                >
                    <a
                        href="/blog/"
                        class="view-all-btn"
                        >Все статьи →</a
                    >
                </div>
            </div>
        </section>
        <!-- EDUCATION -->
        <section class="edu-bg">
            <div class="section">
                <div class="section-header fade-up">
                    <span class="tag" style="font-size: 16px">Образование</span>
                    <h2 class="section-title">Мои дипломы и квалификация</h2>
                    <p class="section-sub">
                        Профессиональное образование, подтверждённое дипломами
                        ведущих ВУЗов
                    </p>
                </div>
                <div class="edu-cards">
                    <div class="edu-card fade-up d1">
                        <div class="edu-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                                <path d="M6 12v5c3 3 9 3 12 0v-5" />
                            </svg>
                        </div>
                        <h3>Московский институт психоанализа</h3>
                        <p>Диплом психолога</p>
                    </div>
                    <div class="edu-card fade-up d2">
                        <div class="edu-icon">
                            <svg viewBox="0 0 24 24">
                                <path
                                    d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"
                                />
                                <path
                                    d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"
                                />
                            </svg>
                        </div>
                        <h3>Московский институт психологии</h3>
                        <p>
                            Диплом о прохождении метода когнитивно-поведенческой
                            терапии
                        </p>
                    </div>
                </div>
            </div>
        </section>
